// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums for AI Assessment
// ============================================================================

enum SymptomDomain {
  depression
  anger
  mania
  anxiety
  somatic_symptoms
  suicidal_tendencies
  psychosis
  sleep_problems
  memory
  repetitive_thoughts
  dissociation
  personality
  substance_use
}

enum AssessmentStatus {
  in_progress
  completed
  abandoned
  expired
}

enum DomainStatus {
  pending
  in_progress
  completed
}

enum MessageRole {
  user
  assistant
  system
}

enum SafetyEventType {
  suicidal_ideation
  self_harm
  violence
  crisis
}

// ============================================================================
// User Screening Result
// ============================================================================

// User's latest screening result (one per user, overwritten on each screening)
model UserScreeningResult {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @unique @db.Uuid
  answers        Json            // { questionId: score }
  domainScores   Json            // { domain: avgScore } - all 13 domains
  flaggedDomains SymptomDomain[] // top 5 with score >= 2
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("user_screening_results")
}

// ============================================================================
// AI Assessment Data Models
// Note: userId references auth.users.id in sphinx-auth (cross-database ref)
// ============================================================================

// Assessment Session - tracks a complete assessment run
model AssessmentSession {
  id        String           @id @default(uuid()) @db.Uuid
  threadId  String           @unique // LangGraph thread ID

  // Cross-database reference to sphinx-auth.auth.users.id
  userId    String?          @db.Uuid

  status    AssessmentStatus @default(in_progress)
  startedAt DateTime         @default(now())
  endedAt   DateTime?

  // Session metadata
  chiefComplaint     String?
  totalQuestions     Int               @default(0)
  flaggedDomains     SymptomDomain[]
  // Snapshot of all 13 domain scores at session creation
  screeningSnapshot  Json?
  isEarlyTermination Boolean           @default(false)

  // Relations (within sphinx-data)
  chatMessages       ChatMessage[]
  domainAssessments  DomainAssessment[]
  report             AssessmentReport?
  safetyEvents       SafetyEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@map("assessment_sessions")
}

// Chat Message - full conversation history
model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  role      MessageRole
  content   String
  sequence  Int         // message order in conversation

  // Optional metadata
  quickReplies String[] // suggested quick replies (for assistant messages)

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([sessionId, sequence])
  @@map("chat_messages")
}

// Domain Assessment - per-domain assessment results
model DomainAssessment {
  id        String        @id @default(uuid()) @db.Uuid
  sessionId String        @db.Uuid
  domain    SymptomDomain
  status    DomainStatus  @default(pending)

  // Scores
  screeningScore   Float  @default(0)
  functionalImpact Int    @default(0) // 0-3
  control          Int    @default(0) // 0-3
  frequency        Int    @default(0) // 0-3
  confidence       Int    @default(0) // 0-3
  duration         String @default("")

  // Evidence collected during chat
  evidenceNotes     String[]
  questionsAsked    Int      @default(0)
  dimensionsCovered String[] // affective, cognitive, etc.

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, domain])
  @@index([sessionId])
  @@map("domain_assessments")
}

// Assessment Report - AI-generated final report
model AssessmentReport {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @unique @db.Uuid

  // Core report content
  chiefComplaint String
  mainGoal       String
  analysis       String // Empathetic 2-3 sentence summary

  // Structured data (stored as JSON)
  domains         Json     // AIReportDomain[]
  findings        Json     // AIReportFinding[]
  recommendations String[]

  // Optional fields
  culturalBackground String?
  summary            String?

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("assessment_reports")
}

// Safety Event - flagged safety concerns
model SafetyEvent {
  id          String          @id @default(uuid()) @db.Uuid
  sessionId   String          @db.Uuid
  eventType   SafetyEventType
  severity    Int             // 1-5 scale
  details     String?
  triggeredBy String?         // which message/domain triggered this

  // Whether provider was notified
  notifiedAt DateTime?

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([eventType])
  @@index([severity])
  @@map("safety_events")
}

// ============================================================================
// Journal Models
// ============================================================================

model JournalEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid 

  content   String   // Entry text
  questions Json?    // Associated questions & responses

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@map("journal_entries")
}
