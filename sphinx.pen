                  "ref": "wdrDL",
                  "width": "fit_content",
                  "name": "msg2",
                  "descendants": {
                    "S8OLj": {
                      "content": "That sounds really difficult. When your heart races in those meetings, are you able to use any strategies to calm down, or does it feel uncontrollable?",
